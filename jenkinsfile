
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm ci'
            }
        }

        stage('Build Application') {
            steps {
                bat 'npm run build'
            }
        }

        stage('Start Application') {
            steps {
                echo 'Starting Calculator application...'

                bat '''
                start "" /B cmd /c "npm run preview -- --host 127.0.0.1 --port 4173 > preview.log 2>&1"
                '''
            }
        }
    }

    post {
        success {
            echo 'Build successful!'
            echo 'Try opening http://localhost:4173/'
        }
    }
}   
