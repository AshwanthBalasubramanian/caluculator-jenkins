
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out Calculator source code'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                bat 'npm ci'
            }
        }

        stage('Build Application') {
            steps {
                echo 'Building Calculator...'
                bat 'npm run build'
            }
        }
         
        stage('Run Application') {
            steps {
                echo 'Starting Calculator Development Server...'

                bat '''
                    @echo off
                    npm run dev -- --host 127.0.0.1 --port 5173 --strictPort
                '''
        }
        }
    }
}
